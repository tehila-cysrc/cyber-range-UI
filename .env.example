# Copy this file to .env at the repo root. Paths are resolved relative to server/
# (npm workspace scripts run with that as cwd), so DB_PATH below resolves to server/data/cyber-range.db.
PORT=4000
DB_PATH=./data/cyber-range.db
TOKEN_TTL_HOURS=12
CLIENT_ORIGIN=http://localhost:5173

# 32 random bytes, base64-encoded (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# Encrypts registered cloud-environment credentials at rest (server/src/services/credential.service.ts).
# Losing/rotating this key makes previously-stored credentials undecryptable — back it up like a secret, never commit it.
CREDENTIAL_MASTER_KEY=replace-with-a-real-base64-32-byte-key

# 32 random bytes, base64-encoded — same generation command as above. Must match whatever key a real
# guacamole-lite server is configured with (server/src/services/accessBroker/guacamoleToken.service.ts).
GUACAMOLE_LITE_SECRET_KEY=replace-with-a-real-base64-32-byte-key

# Optional. Base wss:// URL of a running guacd/guacamole-lite gateway's tunnel endpoint. Unset in this
# dev environment (no guacd deployed yet) — access sessions still get created and tokens still get
# minted, but the connectivity-check-style response comes back with wsUrl: null until this is set.
# GUACD_GATEWAY_WS_URL=wss://guacd.internal/tunnel

# Optional, defaults to 15. How long a minted access-session token/session stays valid before the
# server-side sweep (accessSessionExpiry.service.ts) force-expires it.
# ACCESS_SESSION_TTL_MINUTES=15
