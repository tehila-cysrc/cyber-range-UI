# Copy this file to .env at the repo root. Paths are resolved relative to server/
# (npm workspace scripts run with that as cwd), so DB_PATH below resolves to server/data/cyber-range.db.
PORT=4000
DB_PATH=./data/cyber-range.db
TOKEN_TTL_HOURS=12
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse-proxy hops in front of the server (1 behind Coolify/Traefik). Unset for direct access.
# TRUST_PROXY=1

# 32 random bytes, base64-encoded (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# Encrypts registered cloud-environment credentials at rest (server/src/services/credential.service.ts).
# Losing/rotating this key makes previously-stored credentials undecryptable — back it up like a secret, never commit it.
CREDENTIAL_MASTER_KEY=replace-with-a-real-base64-32-byte-key

# Password for the admin account created on a first start (no active admin yet). Unset = dev default
# `instructor123` — set it on any deployment others can reach.
# INITIAL_ADMIN_PASSWORD=

# Kill switch for scoped instructor accounts: `false` refuses sign-in (and live tokens) of every
# account with role `instructor`; admins and students are unaffected. Default on.
# ENABLE_SCOPED_INSTRUCTORS=true

# Optional, defaults to 15. How long a minted access-session token/session stays valid before the
# server-side sweep (accessSessionExpiry.service.ts) force-expires it.
# ACCESS_SESSION_TTL_MINUTES=15

# --- AI Investigation Assessment (docs/ai-investigation-assessment-plan.md §D) -------------------
# Kill switch: OFF unless true/1/on/yes. Even when on, the feature stays disabled until every value
# below is present and valid. Changing these needs a server restart.
# AI_ASSESSMENT_ENABLED=false
# FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_AGENT_NAME=cyber-range-assessor
# REQUIRED: the reviewed agent version to use. Unset = AI stays disabled — the app never follows
# Foundry's "latest" version, so a new agent version only goes live when this is changed on purpose.
# FOUNDRY_AGENT_VERSION=
# Optional: the response contract that pinned version speaks ("2" = agent v6, "3" = agent v7). Unset = "2".
# Set it together with FOUNDRY_AGENT_VERSION when moving the pin; an unknown value keeps AI disabled.
# FOUNDRY_AGENT_CONTRACT_VERSION=2
# Dedicated Service Principal with the "Foundry User" role on the project (never Contributor/Owner).
# AZURE_CLIENT_SECRET is the secret VALUE (~40 chars), not its ID. Never commit it.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AI_REQUEST_TIMEOUT_MS=120000
# AI_MAX_CONCURRENT=3
